extends Node
## Autoload "Sfx": Sfx.play(&"jump"). Sounds are generated by res://Tools/generate_sfx.gd.

const STREAMS := {
	&"jump": preload("res://Audio/Sfx/jump.wav"),
	&"point": preload("res://Audio/Sfx/point.wav"),
	&"hit": preload("res://Audio/Sfx/hit.wav"),
	&"turtle_hop": preload("res://Audio/Sfx/turtle_hop.wav"),
	&"restart": preload("res://Audio/Sfx/restart.wav"),
}

var params: GameParams = preload("res://Game/game_params.tres")
var _players := {}


func _ready() -> void:
	# Sounds keep playing during the game over pause and across scene reloads.
	process_mode = Node.PROCESS_MODE_ALWAYS
	for sound_name in STREAMS:
		var player := AudioStreamPlayer.new()
		player.stream = STREAMS[sound_name]
		add_child(player)
		_players[sound_name] = player


func play(sound_name: StringName, volume_db := 0.0) -> void:
	var player: AudioStreamPlayer = _players[sound_name]
	player.volume_db = params.sfx_volume_db + volume_db
	player.play()
